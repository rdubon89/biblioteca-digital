<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="BibliotecaDigital.Web.SiteMaster" %>

<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Biblioteca Digital</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        body {
            background-color: #f5f7fa;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            transition: background-color .25s ease, color .25s ease;
        }

        .navbar-mica {
            background: rgba(33, 37, 41, 0.92) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: -.02em;
        }

        .navbar .nav-link {
            color: rgba(255,255,255,.82) !important;
            font-size: .94rem;
            padding-left: .85rem;
            padding-right: .85rem;
        }

        .navbar .nav-link:hover,
        .navbar .nav-link.active {
            color: #ffffff !important;
            font-weight: 600;
        }

        .user-pill {
            color: #ffffff !important;
            opacity: .9;
            font-size: .92rem;
            white-space: nowrap;
        }

        .logout-link {
            color: #ffb3b3 !important;
        }

        .logout-link:hover {
            color: #ffffff !important;
        }

        .theme-switch-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-left: .75rem;
        }

        .theme-icon {
            color: #ffffff;
            font-size: 1rem;
        }

        .theme-toggle {
            position: relative;
            width: 54px;
            height: 30px;
            display: inline-block;
            margin: 0;
        }

        .theme-toggle input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .theme-slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: rgba(255,255,255,.22);
            transition: .25s;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,.12);
        }

        .theme-slider:before {
            content: "";
            position: absolute;
            height: 24px;
            width: 24px;
            left: 2px;
            top: 2px;
            background-color: #ffffff;
            transition: .25s;
            border-radius: 50%;
            box-shadow: 0 1px 4px rgba(0,0,0,.25);
        }

        .theme-toggle input:checked + .theme-slider {
            background-color: #111827;
        }

        .theme-toggle input:checked + .theme-slider:before {
            transform: translateX(24px);
        }

        .main-content {
            min-height: calc(100vh - 76px);
            padding-top: 2rem;
            padding-bottom: 2rem;
        }

        [data-bs-theme="dark"] body {
            background-color: #0f1115;
            color: #f8f9fa;
        }

        [data-bs-theme="dark"] .card,
        [data-bs-theme="dark"] .modal-content,
        [data-bs-theme="dark"] .table,
        [data-bs-theme="dark"] .dropdown-menu,
        [data-bs-theme="dark"] .list-group-item {
            background-color: #1b1f24 !important;
            color: #f8f9fa !important;
            border-color: #343a40 !important;
        }

        [data-bs-theme="dark"] .form-control,
        [data-bs-theme="dark"] .form-select,
        [data-bs-theme="dark"] textarea,
        [data-bs-theme="dark"] select,
        [data-bs-theme="dark"] input {
            background-color: #17191d !important;
            color: #f8f9fa !important;
            border-color: #343a40 !important;
        }

        [data-bs-theme="dark"] .form-control:focus,
        [data-bs-theme="dark"] .form-select:focus,
        [data-bs-theme="dark"] input:focus,
        [data-bs-theme="dark"] textarea:focus {
            border-color: #4d6bfe !important;
            box-shadow: 0 0 0 .2rem rgba(77,107,254,.2) !important;
        }

        [data-bs-theme="dark"] .text-dark {
            color: #f8f9fa !important;
        }

        [data-bs-theme="dark"] .bg-white {
            background-color: #1b1f24 !important;
        }

        [data-bs-theme="dark"] .border {
            border-color: #343a40 !important;
        }

        [data-bs-theme="dark"] .btn,
        [data-bs-theme="dark"] .btn i {
            color: #ffffff !important;
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
    <form id="form1" runat="server">

        <nav class="navbar navbar-expand-lg navbar-dark navbar-mica shadow-sm">
            <div class="container">
                <a class="navbar-brand" href="Home.aspx">
                    <i class="bi bi-book me-2"></i>Biblioteca Digital
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Alternar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <asp:PlaceHolder ID="pnlMenuPublico" runat="server">
                            <li class="nav-item">
                                <a class="nav-link" href="Login.aspx">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Login
                                </a>
                            </li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="pnlMenuAutenticado" runat="server">

                            <li class="nav-item">
                                <a class="nav-link" href="Home.aspx">Inicio</a>
                            </li>

                            <li class="nav-item">
                                <a id="lnkDashboard" runat="server" class="nav-link" href="Dashboard.aspx">Dashboard</a>
                            </li>

                            <li class="nav-item">
                                <a id="lnkLibros" runat="server" class="nav-link" href="AdminLibros.aspx">Libros</a>
                            </li>

                            <li class="nav-item">
                                <a id="lnkUsuarios" runat="server" class="nav-link" href="AdminUsuarios.aspx">Usuarios</a>
                            </li>

                            <li class="nav-item">
                                <span class="nav-link user-pill">
                                    <i class="bi bi-person-circle me-1"></i>
                                    <asp:Label ID="lblUsuarioActual" runat="server" />
                                </span>
                            </li>

                            <li class="nav-item">
                                <asp:LinkButton ID="btnCerrarSesion" runat="server"
                                    CssClass="nav-link logout-link"
                                    OnClick="btnCerrarSesion_Click">
                                    <i class="bi bi-box-arrow-right me-1"></i>Salir
                                </asp:LinkButton>
                            </li>

                        </asp:PlaceHolder>

                        <li class="nav-item mt-2 mt-lg-0">
                            <div class="theme-switch-wrapper">
                                <span class="theme-icon">
                                    <i class="bi bi-moon-stars-fill"></i>
                                </span>
                                <label class="theme-toggle" title="Cambiar tema">
                                    <input type="checkbox" id="themeSwitch" />
                                    <span class="theme-slider"></span>
                                </label>
                            </div>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>

        <main class="container main-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const htmlTag = document.documentElement;
            const themeSwitch = document.getElementById("themeSwitch");

            function getCookie(nombre) {
                const cookies = document.cookie.split(';');

                for (let i = 0; i < cookies.length; i++) {
                    const c = cookies[i].trim();

                    if (c.indexOf(nombre + "=") === 0) {
                        return c.substring(nombre.length + 1);
                    }
                }

                return null;
            }

            function setTheme(tema) {
                htmlTag.setAttribute("data-bs-theme", tema);

                if (themeSwitch) {
                    themeSwitch.checked = tema === "dark";
                }

                document.cookie = "TemaVisual=" + tema + "; path=/; max-age=" + (60 * 60 * 24 * 30);
            }

            const temaGuardado = getCookie("TemaVisual") || "light";
            setTheme(temaGuardado);

            if (themeSwitch) {
                themeSwitch.addEventListener("change", function () {
                    setTheme(this.checked ? "dark" : "light");
                });
            }

            const currentPath = window.location.pathname.toLowerCase();

            document.querySelectorAll(".navbar .nav-link").forEach(function (link) {
                const href = link.getAttribute("href");

                if (href && currentPath.indexOf(href.toLowerCase()) !== -1) {
                    link.classList.add("active");
                }
            });
        });
    </script>
</body>
</html>